DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@localhost:5432/geo_observer
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=PREENCHER
MINIO_SECRET_KEY=PREENCHER
MINIO_SECURE=false
MINIO_BUCKET=imagens
MAX_UPLOAD_BYTES=536870912

# Broker local; use os mesmos valores de usuário/senha na URL.
RABBITMQ_USER=geo_observer
RABBITMQ_PASSWORD=PREENCHER
RABBITMQ_URL=amqp://geo_observer:PREENCHER@localhost:5672/%2F

# Projeto aprovado no Earth Engine. Autentique com poetry run earthengine authenticate.
EE_PROJECT=
# Opcional, para conta de serviço; nunca coloque a chave JSON no repositório.
EE_SERVICE_ACCOUNT_EMAIL=
EE_SERVICE_ACCOUNT_FILE=

# Usar true quando publicado com HTTPS.
COOKIE_SECURE=false

# ID público do cliente OAuth Web para login Google (não é o projeto Earth Engine).
GOOGLE_CLIENT_ID=
