# Gere senhas hexadecimais (somente letras/números); não reutilize .env local.
POSTGRES_PASSWORD=
MINIO_PASSWORD=
RABBITMQ_PASSWORD=
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
# Earth Engine: registre o projeto e use uma conta de serviço no servidor.
EE_PROJECT=
EE_SERVICE_ACCOUNT_EMAIL=
EE_SERVICE_ACCOUNT_FILE=/run/earthengine/service-account.json
# Somente para o perfil HTTPS, depois de apontar o DNS:
SITE_ADDRESS=
